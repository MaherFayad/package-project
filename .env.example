# Database (SQLite in dev; switch provider to postgresql + URL in prod).
# NOTE: we use ELBA_DATABASE_URL (not DATABASE_URL) because some hosts/containers
# pre-set DATABASE_URL to an unrelated Postgres instance.
ELBA_DATABASE_URL="file:./dev.db"

# Session cookie signing secret (32+ random chars). Required in production.
SESSION_SECRET="dev-only-change-me-please-32-chars-min"

# Public site URL (used for share links, SEO canonical URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OTP: under `next dev` the code is logged and shown in the dev banner by default.
# OTP_DEV_ECHO is a local-testing flag: see the block at the end of this file.

# Payments (Paymob-style). "mock" in dev.
PAYMENTS_PROVIDER="mock"
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID_CARD=""
PAYMOB_INTEGRATION_ID_WALLET=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_INTEGRATION_ID_KIOSK=""
PAYMOB_INTEGRATION_ID_INSTAPAY=""
# Prepayment discount in percent. Empty = the launch default of 3% (plan §7.3); "0" turns it off.
# An admin "checkout" setting row overrides this. Also: Fawry code lifetime, InstaPay address.
PREPAY_DISCOUNT_PCT=""
FAWRY_EXPIRY_HOURS="48"
INSTAPAY_ADDRESS="elba@instapay"
# Mock gateway: on under `next dev`. ALLOW_MOCK_PAYMENTS is a local-testing flag (see the end).

# Shipping (Bosta-style). "mock" in dev.
SHIPPING_PROVIDER="mock"
BOSTA_API_KEY=""

# Vendor portal uploads (QC photos, certificates, portfolio, application documents).
# Default: ./var/uploads (outside /public; served with access checks by /api/vendor/files).
# ELBA_UPLOAD_DIR=

# WhatsApp Business (Cloud API) inbound webhook: POST/GET /api/webhooks/whatsapp. A "STOP" / «إيقاف»
# reply withdraws marketing consent (PDPL 151/2020). Without the app secret the route answers 503.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------------------------
# LOCAL TESTING ONLY. Never set these in a deployment.
# They matter only under `next start` (local prod builds, e2e); `next dev` behaves as if the
# first two were on. When NEXT_PUBLIC_SITE_URL starts with https:// (a real deployment) all of
# them are ignored and one warning is logged (src/lib/env.ts `devFlag`).
# The e2e command passes them itself: OTP_DEV_ECHO=1 ALLOW_MOCK_PAYMENTS=1 npx playwright test
# OTP_DEV_ECHO="1"          # return the OTP as devCode and log it
# ALLOW_MOCK_PAYMENTS="1"   # mock gateway and its "simulate payment" endpoint
# ELBA_E2E="1"              # relaxed per-IP OTP limits (with OTP_DEV_ECHO) and /dev pages
# ELBA_DEV_PAGES="1"        # /[locale]/dev/* tools
