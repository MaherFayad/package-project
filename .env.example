# Database (SQLite in dev; switch provider to postgresql + URL in prod).
# NOTE: we use ELBA_DATABASE_URL (not DATABASE_URL) because some hosts/containers
# pre-set DATABASE_URL to an unrelated Postgres instance.
ELBA_DATABASE_URL="file:./dev.db"

# Session cookie signing secret (32+ random chars). Required in production.
SESSION_SECRET="dev-only-change-me-please-32-chars-min"

# Public site URL (used for share links, SEO canonical URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OTP: in dev the code is logged to the server console and returned to the client
# for the dev banner. Set to "1" to force-show it outside development (never in prod).
OTP_DEV_ECHO="1"

# Payments (Paymob-style). "mock" in dev.
PAYMENTS_PROVIDER="mock"
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID_CARD=""
PAYMOB_INTEGRATION_ID_WALLET=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_INTEGRATION_ID_KIOSK=""
PAYMOB_INTEGRATION_ID_INSTAPAY=""
# Optional prepayment discount in percent (0 = off), Fawry code lifetime, InstaPay address.
PREPAY_DISCOUNT_PCT="0"
FAWRY_EXPIRY_HOURS="48"
INSTAPAY_ADDRESS="elba@instapay"
# Mock gateway under `next start` (local prod builds and e2e only). NEVER set in a deployment.
ALLOW_MOCK_PAYMENTS="1"

# Shipping (Bosta-style). "mock" in dev.
SHIPPING_PROVIDER="mock"
BOSTA_API_KEY=""

# Vendor portal uploads (QC photos, certificates, portfolio, application documents).
# Default: ./var/uploads (outside /public; served with access checks by /api/vendor/files).
# ELBA_UPLOAD_DIR=
