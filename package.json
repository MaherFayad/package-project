{
  "name": "elba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-i18n-scopes.ts && tsx scripts/generate-route-slugs.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:size": "node scripts/check-bundle-size.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "jobs:daily": "tsx scripts/run-daily-jobs.ts",
    "postinstall": "prisma generate",
    "db:schema:pg": "tsx scripts/generate-postgres-schema.ts",
    "db:migrate:pg": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "cf:build": "tsx scripts/generate-postgres-schema.ts && prisma generate --schema prisma/postgres/schema.prisma && opennextjs-cloudflare build && tsx scripts/cloudflare/write-build-facts.ts; status=$?; prisma generate >/dev/null; exit $status",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.69.0",
    "next": "^15.5.29",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^31.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.158.0"
  }
}
