// Elba data model. Dev: SQLite. Prod: PostgreSQL (change `provider` + DATABASE_URL only).
// Conventions (see docs/ARCHITECTURE.md):
//  - Money is stored as INTEGER PIASTERS (1 EGP = 100 piasters), field names end in `Piasters`.
//  - "Enum-like" fields are String columns; their allowed values are TS unions in src/types/*.ts.
//  - Structured blobs use Json (supported by Prisma on SQLite >= 6.2 and native jsonb on Postgres).
//  - Bilingual text uses paired columns: xxxAr / xxxEn.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("ELBA_DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id               String    @id @default(cuid())
  phone            String    @unique // E.164, e.g. +201001234567
  name             String?
  email            String?
  role             String    @default("BUYER") // Role: BUYER | VENDOR | ADMIN
  locale           String    @default("ar") // Locale: ar | en
  marketingConsent Boolean   @default(false)
  consentAt        DateTime?
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  vendorId         String?   // set for role=VENDOR (vendor staff)
  vendor           Vendor?   @relation("VendorStaff", fields: [vendorId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  sessions  Session[]
  designs   Design[]
  quotes    Quote[]
  orders    Order[]
  reviews   Review[]
  consents  Consent[]
  disputes  Dispute[]

  @@index([role])
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([vendorId])
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  taxId      String?  // Egyptian tax registration number (for B2B e-invoices)
  commercialRegister String?
  city       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the cookie token; raw token never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   // sha256(phone + code + secret)
  expiresAt DateTime
  attempts  Int      @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())
  ip        String?

  @@index([phone, createdAt])
}

model Consent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone     String?
  kind      String   // ConsentKind: TERMS | PRIVACY | MARKETING | RETARGETING
  granted   Boolean
  textVersion String // version id of the wording shown
  locale    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, kind])
}

// ───────────────────────────── Vendors ─────────────────────────────

model Vendor {
  id             String   @id @default(cuid())
  slug           String   @unique
  nameAr         String
  nameEn         String
  city           String   // canonical city key, see src/types/vendor.ts EgyptCity
  cityAr         String
  cityEn         String
  bioAr          String
  bioEn          String
  // B-08 / R5 (vendor): bio edits wait here until Elba ops approves them; bioAr/bioEn stay public.
  bioArPending    String?
  bioEnPending    String?
  bioReviewStatus String?   // null = nothing waiting | PENDING | REJECTED
  bioReviewNote   String?   // shown to the vendor on rejection
  bioSubmittedAt  DateTime?
  logoUrl        String?
  coverUrl       String?
  machines       Json     // VendorMachine[]
  capabilities   Json     // VendorCapabilities
  certifications Json     // VendorCertification[] (e.g. { code: "FOOD_SAFE", ... })
  foodSafe       Boolean  @default(false)
  rating         Float    @default(0) // 0..5
  ratingCount    Int      @default(0)
  onTimePct      Float    @default(0) // 0..100
  leadTimeDays   Int      @default(7) // typical lead time
  minOrderQty    Int      @default(100)
  serviceAreas   Json     // EgyptCity[]
  verified       Boolean  @default(false)
  status         String   @default("ACTIVE") // VendorStatus: PENDING | ACTIVE | SUSPENDED
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff      User[]                @relation("VendorStaff")
  portfolio  VendorPortfolioItem[]
  rateCards  RateCard[]
  orders     Order[]
  payouts    Payout[]
  reviews    Review[]

  @@index([status, verified])
}

model VendorPortfolioItem {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  imageUrl      String   // local path under /public, e.g. /seed/portfolio/nile-1.svg
  captionAr     String
  captionEn     String
  structureCode String?  // StructureCode
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  // Added by vendor portal (B-08): a photo goes public only after Elba reviews it (no phone numbers,
  // logos with contact details or QR codes). PENDING | APPROVED | REJECTED; seed rows are APPROVED.
  status        String   @default("APPROVED")
  reviewNote    String?

  @@index([vendorId])
  @@index([status])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Structure {
  id           String  @id @default(cuid())
  code         String  @unique // StructureCode: FEFCO_0427 | FEFCO_0201 | ECMA_RTE | ECMA_STE | PIZZA | SLEEVE
  slug         String  @unique // URL slug, e.g. "mailer-box"
  family       String  // StructureFamily: CORRUGATED | FOLDING_CARTON
  nameAr       String
  nameEn       String
  descriptionAr String
  descriptionEn String
  params       Json    // StructureParamLimits (mm)
  defaultDims  Json    // Dims (mm)
  presets      Json    // DimsPreset[]
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  rateCards RateCard[]
}

// Added by 3D integration: every model of the library (src/lib/library) the designer and the
// catalogue show: family box styles and containers. Each is produced and priced as one of its
// BASE structures (Structure rows + their rate cards), per board.
model CatalogModel {
  id            String  @id @default(cuid())
  code          String  @unique // library model code, e.g. FEFCO_0203, ECMA_TUCK_STE, ROUND_BOTTLE
  slug          String  @unique
  kind          String  // "box" | "vessel"
  group         String  // ModelGroup: BOXES | CARTONS | RIGID | TRAYS | TUBES | BOTTLES_JARS | POUCHES | CANS
  source        String  // generator family
  standard      String  @default("")
  nameAr        String
  nameEn        String
  descriptionAr String
  descriptionEn String
  baseCodes     Json    // StructureCode[]: base structures (rate cards) per board / print material
  materials     Json    // MaterialCode[]
  presets       Json    // size presets (box: DimsPreset[], vessel: { id, name, dims }[])
  imageUrl      String
  sortOrder     Int     @default(0)
  active        Boolean @default(true)

  @@index([group, sortOrder])
}

model Material {
  id         String  @id @default(cuid())
  code       String  @unique // e.g. E_FLUTE_KRAFT
  family     String  // StructureFamily this material is valid for
  boardType  String  // BoardType: CORRUGATED | SBS
  flute      String? // Flute: E | B | null for SBS
  color      String  // BoardColor: KRAFT | WHITE
  gsm        Int
  thicknessMm Float
  nameAr     String
  nameEn     String
  foodSafe   Boolean @default(false)
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  rateCards RateCard[]
  designs   Design[]
}

model Finish {
  id        String  @id @default(cuid())
  code      String  @unique // FinishCode: NONE | MATTE_LAMINATION | GLOSS_LAMINATION | SPOT_UV
  nameAr    String
  nameEn    String
  // Surcharge per unit (piasters) and per-order setup (piasters) — platform defaults;
  // vendors may override in RateCard.finishSurcharges.
  unitSurchargePiasters  Int @default(0)
  setupPiasters          Int @default(0)
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model RateCard {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  structureId   String
  structure     Structure @relation(fields: [structureId], references: [id])
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id])
  // RateTier[]: [{ minQty, unitPiasters }] unit price (vendor BUY price, ex-VAT) for a
  // reference box area; see src/lib/pricing for area scaling.
  qtyTiers      Json
  referenceAreaM2 Float   // blank (flat sheet) area the tier prices are quoted for
  setupPiasters Int      // one-off setup / plate cost
  dieCostPiasters Int    // one-off cutting die cost (waived for standard sizes)
  printSidesSurchargePct Float @default(0) // extra % for 2-sided print
  finishSurcharges Json  // Partial<Record<FinishCode, number>> unit piasters
  leadTimeDays  Int
  // Added by vendor portal: cutting dies the vendor already owns for this structure, Dims[] (inner mm).
  // Sizes within ±2 mm are "standard" for this vendor (no die cost). Maps to pricing `ownedDies`.
  standardDies  Json     @default("[]")
  active        Boolean  @default(true)
  validFrom     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([vendorId, structureId, materialId])
  @@index([structureId, materialId])
}

// ───────────────────────────── Design & proof ─────────────────────────────

model Design {
  id            String    @id @default(cuid())
  ownerId       String?   // null => anonymous
  owner         User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  anonId        String?   // anonymous browser id (cookie "elba_anon") before sign-up
  name          String    @default("")
  structureCode String    // StructureCode (the BASE structure a library model is priced as)
  // Added by 3D integration: library model (family box style or container), null = the core structure.
  modelCode     String?
  // Added by 3D integration: { features?, finishes?, vessel? } (DesignDoc fields beyond the columns).
  config        Json?
  dims          Json      // Dims (mm)
  materialId    String?
  material      Material? @relation(fields: [materialId], references: [id])
  finishCode    String    @default("NONE")
  printSides    String    @default("OUTSIDE") // PrintSides: OUTSIDE | BOTH
  artwork       Json      // DesignDoc["artwork"] (ArtworkSide map of ArtworkLayer[])
  thumbnailUrl  String?
  shareToken    String?   @unique // public share link token (account required to create)
  expiresAt     DateTime? // anonymous designs expire after 30 days
  // Added by platform round 3 (B-23): when the one 24 h WhatsApp follow-up for this saved design
  // was sent (src/lib/jobs/followUp.ts). Set once, never cleared, so a design is nudged at most once.
  followedUpAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  proofs Proof[]

  @@index([ownerId])
  @@index([anonId])
  @@index([ownerId, followedUpAt])
}

model Proof {
  id          String    @id @default(cuid())
  designId    String
  design      Design    @relation(fields: [designId], references: [id])
  version     Int       @default(1)
  snapshot    Json      // immutable DesignDoc snapshot at proof time
  hash        String    // sha256 of canonical JSON of snapshot
  pdfUrl      String?   // flat PDF proof (with dieline)
  previewUrl  String?   // 3D render PNG
  approvedAt  DateTime?
  approvedIp  String?
  approvedById String?
  /// Added by technical audit round 3 (B-04): server-side preflight of the snapshot at approval
  /// ({ errors, warnings, issues[], acknowledged, ran }), the same check the designer shows.
  preflight   Json?
  createdAt   DateTime  @default(now())

  orderItems OrderItem[]

  @@index([designId])
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([approvedById])
}

// ───────────────────────────── Commerce ─────────────────────────────

model Quote {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  designId   String?
  vendorId   String?
  lines      Json     // QuoteLine[]
  subtotalPiasters Int
  vatPiasters      Int   // 14%
  shippingPiasters Int   @default(0)
  totalPiasters    Int
  currency   String   @default("EGP")
  validUntil DateTime // createdAt + 72h
  status     String   @default("OPEN") // QuoteStatus: OPEN | ACCEPTED | EXPIRED; price requests: REQUESTED -> PRICED -> ACCEPTED
  createdAt  DateTime @default(now())
  // Added by checkout R4-B-03 (agreed with admin): a price the team sends for a price request.
  pricedAt           DateTime? // when the team sent the price (status PRICED)
  deliveryDays       Int?      // production + transit days promised with that price
  vendorCostPiasters Int?      // the printer's agreed price for the whole job, ex-VAT (payouts, margin)

  orders Order[]
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([userId])
  // Added by technical R4-05: the admin quote-leads inbox lists REQUESTED quotes newest first.
  @@index([status, createdAt])
}

model Order {
  id          String   @id @default(cuid())
  number      String   @unique // human order number, e.g. ELB-24001
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  quoteId     String?
  quote       Quote?   @relation(fields: [quoteId], references: [id])
  status      String   @default("PENDING_PAYMENT") // OrderStatus (src/types/order.ts)
  subtotalPiasters Int
  vatPiasters      Int
  shippingPiasters Int  @default(0)
  totalPiasters    Int
  vendorCostPiasters Int @default(0) // platform buy price from vendor (managed model)
  currency    String   @default("EGP")
  shippingAddress Json // ShippingAddress
  notes       String?
  placedAt    DateTime @default(now())
  paidAt      DateTime?
  dueDate     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  // Reserved by platform round 3 (B-24, Phase 3 designer referral programme): the referring
  // designer's User.id. Nullable, no relation and no UI yet; written by nothing today.
  referrerId  String?
  updatedAt   DateTime @updatedAt

  items            OrderItem[]
  productionEvents ProductionEvent[]
  qcPhotos         QcPhoto[]
  shipments        Shipment[]
  payments         Payment[]
  invoices         Invoice[]
  reviews          Review[]
  disputes         Dispute[]
  payouts          Payout[]

  @@index([buyerId])
  @@index([vendorId, status])
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([status, placedAt])
  @@index([referrerId])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proofId       String?
  proof         Proof?  @relation(fields: [proofId], references: [id])
  structureCode String
  // Added by 3D integration: library model and its config ({ features?, finishes?, vessel? }).
  modelCode     String?
  config        Json?
  dims          Json    // Dims
  materialCode  String
  finishCode    String
  printSides    String
  quantity      Int
  unitPiasters  Int
  lineTotalPiasters Int
  printPdfUrl   String? // print-ready dieline PDF, generated only for orders
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([orderId])
  @@index([proofId])
}

model ProductionEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // ProductionEventType (src/types/order.ts)
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  // Added by technical R4-05: platform-wide marker lookups (monthly sample cap counts
  // NOTE "SAMPLE_ORDER" since the 1st of the month on every sample offer) scanned the whole table.
  @@index([note, createdAt])
}

model QcPhoto {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url        String
  kind       String   @default("FIRST_SHEET") // FIRST_SHEET | PACKED_BUNDLE | OTHER
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote String?
  uploadedAt DateTime @default(now())
  reviewedAt DateTime?
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([orderId])
}

model Shipment {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     String   // "mock" | "bosta" | "vendor_van"
  trackingNumber String?
  status       String   @default("CREATED") // ShipmentStatus
  labelUrl     String?
  events       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([orderId])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String   // "mock" | "paymob"
  method      String   // PaymentMethod: CARD | WALLET | FAWRY | INSTAPAY
  status      String   @default("PENDING") // PaymentStatus: PENDING | PAID | FAILED | REFUNDED
  amountPiasters Int
  providerRef String?  // gateway transaction id
  fawryRef    String?  // Fawry reference code to pay at outlet
  raw         Json?    // last webhook payload (sanitized)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerRef])
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([orderId, status])
}

model Payout {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  kind        String   // PayoutKind: ADVANCE | BALANCE
  amountPiasters Int
  status      String   @default("PENDING") // PENDING | APPROVED | PAID
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([vendorId])
  @@index([orderId])
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  kind      String   @default("SALE") // SALE | CREDIT_NOTE
  subtotalPiasters Int
  vatPiasters      Int
  totalPiasters    Int
  etaUuid   String?  // Egyptian Tax Authority e-invoice UUID once submitted
  etaStatus String?  // null | SUBMITTED | VALID | INVALID
  issuedAt  DateTime @default(now())
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([orderId])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  rating    Int      // 1..5
  body      String?
  createdAt DateTime @default(now())

  @@unique([orderId, authorId])
  @@index([vendorId])
}

model Dispute {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  openedById String
  openedBy   User     @relation(fields: [openedById], references: [id])
  reason     String   // DisputeReason: PRINT_DEFECT | WRONG_ITEM | LATE | DAMAGED | OTHER
  description String
  status     String   @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED_REPRINT | RESOLVED_REFUND | REJECTED
  resolution String?
  /// Added by checkout round 9: the buyer's photos with the report, a JSON list of private upload
  /// keys (`dispute/<orderId>/<random>.<ext>`, served by /api/vendor/files to the buyer and admins).
  photos     Json?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  /// Added by technical audit round 2: number of disputes the order had before this one. With the
  /// unique below, two simultaneous submits cannot both open a dispute. Null on older rows.
  seq        Int?
  // Added by technical audit: foreign-key / filter indexes (no FK auto-index in SQLite or Postgres).
  @@index([orderId])
  @@index([status])
  @@unique([orderId, seq])
}

// ───────────────────────────── Privacy (PDPL 151/2020 data-subject requests) ─────────────────────────────
// Added by storefront (account area). Export requests are fulfilled instantly (download) and logged;
// delete requests are queued for ops (orders/invoices must be kept for tax law, so deletion is reviewed).
model DataRequest {
  id          String    @id @default(cuid())
  userId      String    // no relation on purpose (row must survive account anonymisation)
  kind        String    // DataRequestKind: EXPORT | DELETE
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | REJECTED
  note        String?
  ip          String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, kind])
}

// ───────────────────────────── Vendor onboarding (added by vendor portal) ─────────────────────────────
// /[locale]/vendor/apply creates a Vendor row with status PENDING plus this application. Admin reviews it:
// on approval set Vendor.status = ACTIVE (+ verified), User(applicantId).role = VENDOR and .vendorId = vendorId.
// Document keys point at private uploads served by /api/vendor/files/<key> (admin + applicant only).
model VendorApplication {
  id                   String    @id @default(cuid())
  applicantId          String    // User.id of the person who applied
  vendorId             String    @unique // the PENDING Vendor row created with the application
  legalName            String
  commercialRegisterNo String
  taxCardNo            String
  factoryAddress       String
  factoryCity          String    // EgyptCity
  contactName          String
  contactPhone         String    // E.164
  documents            Json      // VendorApplicationDocument[] { kind, key, name, size, type }
  message              String?
  status               String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED
  reviewNote           String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([applicantId])
  @@index([status])
}

// ───────────────────────────── Admin (added by admin) ─────────────────────────────
// Append-only log of every admin mutation (who, what, before/after). Never updated or deleted.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // User.id of the admin (no relation: the row must outlive account deletion)
  actorPhone String?
  action     String   // AuditAction, e.g. ORDER_REASSIGN, ORDER_REFUND, VENDOR_SUSPEND, PRICING_UPDATE
  entityType String   // ORDER | VENDOR | VENDOR_APPLICATION | DISPUTE | USER | DATA_REQUEST | STRUCTURE | MATERIAL | FINISH | SETTINGS
  entityId   String?
  summary    String?  // short human-readable detail (e.g. order number)
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

// Platform settings edited from /admin (key/value). Key "pricing" holds AdminPricingSettings
// (margin, quote validity, zone rates, price index rows) merged onto DEFAULT_PRICING_CONFIG.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────── Analytics (added by platform round 3, B-19) ─────────────────────────────
// First-party product analytics: one row per funnel event from docs/business/launch-metrics.md §1,
// written only by src/lib/analytics/track.ts. No third-party pixels, so no extra PDPL consent.
// Data minimisation (Egypt PDPL Law 151/2020): pseudonymous ids only (userId = User.id, anonId =
// the elba_anon cookie). NEVER a phone number, email, name, address, IP address or user agent: track()
// drops such keys and values before writing. Retention: rows older than 13 months are deleted by
// the daily job (src/lib/jobs/retention.ts). No relation on purpose: a DELETE data request removes
// the user's rows with `event.deleteMany({ where: { userId } })` (admin anonymise flow; compliance-checklist.md 2.9).
model Event {
  id       String   @id @default(cuid())
  name     String   // AnalyticsEventName (src/lib/analytics/events.ts)
  at       DateTime @default(now())
  userId   String?
  anonId   String?
  designId String?
  orderId  String?
  props    Json?    // small flat object: locale, device, structure_code, gate_reason, utm_*, ...

  @@index([name, at])
  @@index([userId, name])
  @@index([anonId])
  @@index([at])
}
